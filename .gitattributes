# 1) Normalize line endings for text files
* text=auto

# Force LF for code (recommended for CI)
*.py text eol=lf
*.sh text eol=lf

# 2) Treat common binary files as binary (no EOL/diff)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.zip binary
*.parquet binary
*.pyc binary
*.h5 binary
*.pb binary
models/** binary

# 3) Jupyter notebooks: strip outputs on commit (use nbstripout) OR use nbdime for diffs
# If you use nbstripout (recommended): install nbstripout and run `nbstripout --install`
*.ipynb filter=nbstripout

# Alternative: use nbdime merge/diff driver (useful for richer diffs)
# *.ipynb diff=jupyternotebook merge=jupyternotebook

# 4) Prevent large data & model files from being included in git archive (release)
# Use export-ignore to keep archives small (data should not be distributed with code)
data/** export-ignore
models/** export-ignore
.mlruns/** export-ignore

# 5) Git LFS support (if you use Git LFS for large files)
# note: you still need `git lfs install` and `git lfs track` locally
*.parquet filter=lfs diff=lfs merge=lfs -text
*.h5 filter=lfs diff=lfs merge=lfs -text
models/** filter=lfs diff=lfs merge=lfs -text

# 6) Optional: mark auto-generated files to not be counted by GitHub linguist
*.ipynb linguist-generated
data/** linguist-generated
models/** linguist-generated

